shell-integration = zsh

font-family = "Monaco Nerd Font Mono"
font-size = 15

window-padding-y = 0
window-padding-x = 5
window-padding-balance = true
window-padding-color = extend
window-save-state = never

# Show the GTK titlebar/window controls on Ubuntu.
window-decoration = auto

# Use Ghostty-managed GTK colors so the titlebar matches the terminal.
window-theme = ghostty
window-titlebar-background = #000000
window-titlebar-foreground = #ffffff
# Show the working directory as a second line under the title.
window-subtitle = working-directory
gtk-toolbar-style = flat
window-show-tab-bar = never

window-height = 100
window-width = 100

theme = "Dark Modern"
confirm-close-surface = false
background=#000000
background-opacity = 0.85
background-blur = true
# Apply opacity+blur to cells with explicit background colors too (frosted popups)
background-opacity-cells = true

bold-is-bright = true
cursor-opacity = .8

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false

# Creating splits
# keybind = ctrl+shift+h=new_split:left
# keybind = ctrl+shift+j=new_split:down
# keybind = ctrl+shift+k=new_split:up
# keybind = ctrl+shift+l=new_split:right

# Navigating splits
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right

# split-divider-color = #454545
unfocused-split-opacity = 1.0

adjust-cell-height = 10%

# ======================
# Keybindings
# ======================
# Wipe ALL default keybinds (tabs, splits, 1.3's cmd+j/cmd+e steals, etc.) —
# tmux handles multiplexing. Only the allowlist below exists.
keybind = clear

# Essentials
keybind = cmd+c=copy_to_clipboard:mixed
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+enter=toggle_fullscreen
# cmd+k clears via Ctrl+L (form feed) not clear_screen: inside tmux, Ghostty's
# clear_screen is instantly repainted by tmux, so it looks dead. Ctrl+L clears
# the active pane in tmux and at a bare zsh prompt alike.
keybind = cmd+k=text:\x0c
keybind = cmd+comma=open_config
keybind = cmd+r=reload_config

# Font size. Use the literal +/=/-/0 keys, matching Ghostty's own defaults. The
# key-NAME forms (cmd+minus, cmd+zero, …) don't match the key event on macOS —
# that's why cmd+minus silently failed to zoom out while cmd+= still worked.
keybind = cmd+==increase_font_size:1
keybind = cmd++=increase_font_size:1
keybind = cmd+kp_add=increase_font_size:1
keybind = cmd+-=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Shift+Enter as CSI-u so it survives tmux — a raw \n is Ctrl+J, which
# tmux's C-j pane-navigation binding steals (see tmux.conf S-Enter).
keybind = shift+enter=csi:13;2u

# Send cmd+key as ESC key (meta) so they survive tmux; nvim maps <M-...>
# (tmux can't forward the cmd/super modifier: tmux/tmux#3335)
keybind = cmd+p=esc:p
keybind = cmd+b=esc:b
keybind = cmd+j=esc:j
keybind = cmd+s=esc:s
keybind = cmd+f=esc:f
keybind = cmd+/=esc:/
keybind = cmd+a=esc:a
keybind = cmd+i=esc:i
# cmd+w -> M-w, which tmux binds to kill-window (close the current window/tab),
# so cmd+w closes the tmux window instead of the Ghostty surface.
keybind = cmd+w=esc:w
# cmd+t -> M-t, which tmux binds to new-window (new tab in the current session).
keybind = cmd+t=esc:t

# Ctrl+Tab / Ctrl+Shift+Tab -> standard CSI-u sequences (9=Tab; 5=Ctrl,
# 6=Ctrl+Shift). Ghostty/macOS grab Ctrl+Tab, so we emit it explicitly with the
# csi: action; tmux decodes these into C-Tab / C-S-Tab via extended-keys.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u

# Notify when long commands finish (if terminal is unfocused)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
