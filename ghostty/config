shell-integration = zsh
# SSH: install ghostty terminfo on remote hosts (keeps TERM=xterm-ghostty);
# falls back to TERM=xterm-256color if the install fails. Replaces the old
# blanket `export TERM=xterm-256color` that masked capabilities locally.
shell-integration-features = ssh-env,ssh-terminfo

font-family = "Monaco Nerd Font Mono"
font-size = 15
font-thicken = true

window-padding-y = 0
window-padding-x = 5
# window-padding-balance = true
window-padding-color = extend
window-save-state = never
# window-decoration = false
window-theme = dark
macos-window-shadow = true
# macos-titlebar-proxy-icon = hidden

window-height = 100
window-width = 100

theme = "Dark Modern"
confirm-close-surface = false
# Show the titlebar so the tmux-set window title (tmux.conf set-titles) is
# visible. transparent = single-line titlebar tinted by the background color.
# Not "tabs": that style always embeds the tab-bar row in the titlebar, which
# on macOS 26 renders a stray "…" overflow control and doubles the height even
# with one tab (window-show-tab-bar is Linux-only, so it can't be hidden).
macos-titlebar-style = native
# Titlebar text stays in the system font (native macOS look — no monospace or
# icon glyphs in titlebars). The tmux-set title is plain text.
# No traffic lights — cleaner bar. cmd+q quits; minimize/zoom stay available
# in the menu bar's Window menu.
# macos-window-buttons = hidden
background=#000000
background-opacity = 0.85
# Native macOS 26+ glass. On older macOS the glass material is unavailable and
# blur silently falls back — swap the two lines below for a numeric radius there.
background-blur = macos-glass-regular
# background-blur = 35
# Apply opacity+blur to cells with explicit background colors too (frosted popups)
background-opacity-cells = true

bold-is-bright = true
cursor-opacity = .8
# Trailing "smear" cursor. Ghostty 1.2+ feeds cursor position/color to custom
# shaders; cursor_smear.glsl draws a short hexagonal trail in the cursor color.
# Path is relative to ~/.config/ghostty/; the .glsl ships in ghostty/shaders/
# and install.sh copies it there. animation=always keeps the trail running
# even when the terminal is otherwise idle (without it the trail can stall).
custom-shader = shaders/cursor_smear.glsl
custom-shader-animation = always

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false

# Creating splits
# keybind = ctrl+shift+h=new_split:left
# keybind = ctrl+shift+j=new_split:down
# keybind = ctrl+shift+k=new_split:up
# keybind = ctrl+shift+l=new_split:right

# Navigating splits
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right

# split-divider-color = #454545
unfocused-split-opacity = 1.0

adjust-cell-height = 12%

# ======================
# Keybindings
# ======================
# Wipe ALL default keybinds (tabs, splits, 1.3's cmd+j/cmd+e steals, etc.) —
# tmux handles multiplexing. Only the allowlist below exists.
keybind = clear

# Essentials
# cmd+c is sent as CSI-u super+c (same channel as ctrl+tab below) so every
# layer sees a discrete key no human sequence can fake: tmux decodes it as
# M-c (super maps to meta) and copies the copy-mode selection, nvim outside
# tmux decodes it as <D-c>, zsh binds the raw sequence to a no-op. esc:c
# would work too but is byte-identical to Esc-then-c, forcing vi-mode
# timing hacks in every layer below. Native shift-drag selections still
# copy without it via copy-on-select above.
keybind = cmd+c=csi:99;9u
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+enter=toggle_fullscreen
# cmd+k clears via Ctrl+L (form feed) not clear_screen: inside tmux, Ghostty's
# clear_screen is instantly repainted by tmux, so it looks dead. Ctrl+L clears
# the active pane in tmux and at a bare zsh prompt alike.
keybind = cmd+k=text:\x0c
keybind = cmd+comma=open_config
keybind = cmd+r=reload_config

# Font size. Use the literal +/=/-/0 keys, matching Ghostty's own defaults. The
# key-NAME forms (cmd+minus, cmd+zero, …) don't match the key event on macOS —
# that's why cmd+minus silently failed to zoom out while cmd+= still worked.
keybind = cmd+==increase_font_size:1
keybind = cmd++=increase_font_size:1
keybind = cmd+kp_add=increase_font_size:1
keybind = cmd+-=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Shift+Enter as CSI-u so it survives tmux — a raw \n is Ctrl+J, which
# tmux's C-j pane-navigation binding steals; tmux.conf's S-Enter binding
# does the per-pane translation. Outside tmux: Claude Code/nvim decode
# CSI-u natively, zsh binds it to accept-line (functions.zsh); other
# legacy REPLs see an unknown CSI instead of a newline — accepted trade.
keybind = shift+enter=csi:13;2u

# Send cmd+key as ESC key (meta) so they survive tmux; nvim maps <M-...>
# (tmux can't forward the cmd/super modifier: tmux/tmux#3335)
keybind = cmd+p=esc:p
keybind = cmd+b=esc:b
keybind = cmd+j=esc:j
keybind = cmd+s=esc:s
keybind = cmd+f=esc:f
keybind = cmd+/=esc:/
keybind = cmd+a=esc:a
keybind = cmd+i=esc:i
# cmd+w -> M-w, which tmux binds to kill-window (close the current window/tab),
# so cmd+w closes the tmux window instead of the Ghostty surface.
keybind = cmd+w=esc:w
# cmd+t -> M-t, which tmux binds to new-window (new tab in the current session).
keybind = cmd+t=esc:t

# Ctrl+Tab / Ctrl+Shift+Tab -> standard CSI-u sequences (9=Tab; 5=Ctrl,
# 6=Ctrl+Shift). Ghostty/macOS grab Ctrl+Tab, so we emit it explicitly with the
# csi: action; tmux decodes these into C-Tab / C-S-Tab via extended-keys.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u

# Notify when long commands finish (if terminal is unfocused)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
