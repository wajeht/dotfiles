shell-integration = zsh

font-family = Monaco
font-size = 15
font-thicken = true

window-padding-y = 0
window-padding-x = 5
window-padding-balance = true
window-padding-color = extend
window-save-state = never
# window-decoration = false
window-theme = dark
macos-window-shadow = true
macos-titlebar-proxy-icon = hidden

window-height = 100
window-width = 100

theme = "dark modern"
confirm-close-surface = false
# Hide the titlebar (and with it the tab bar) but keep the window frame —
# window-decoration=none leaves a titlebar-sized gap at the top on macOS 26.
# Tab keybinds are cleared below; tmux handles multiplexing.
macos-titlebar-style = hidden
background=#000000
background-opacity = 0.85
# Native macOS 26+ glass. On older macOS the glass material is unavailable and
# blur silently falls back — swap the two lines below for a numeric radius there.
background-blur = macos-glass-regular
# background-blur = 35
# Apply opacity+blur to cells with explicit background colors too (frosted popups)
background-opacity-cells = true

bold-is-bright = true
cursor-opacity = .8

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false

# Creating splits
# keybind = ctrl+shift+h=new_split:left
# keybind = ctrl+shift+j=new_split:down
# keybind = ctrl+shift+k=new_split:up
# keybind = ctrl+shift+l=new_split:right

# Navigating splits
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right

# split-divider-color = #454545
unfocused-split-opacity = 1.0

adjust-cell-height = 10%

# ======================
# Keybindings
# ======================
# Wipe ALL default keybinds (tabs, splits, 1.3's cmd+j/cmd+e steals, etc.) —
# tmux handles multiplexing. Only the allowlist below exists.
keybind = clear

# Essentials
keybind = cmd+c=copy_to_clipboard:mixed
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+n=new_window
keybind = cmd+w=close_surface
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+k=clear_screen
keybind = cmd+r=reload_config

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+equal=increase_font_size:1
keybind = cmd+kp_add=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Add a new line when shift+enter is pressed
keybind = shift+enter=text:\n

# Send cmd+key as ESC key (meta) so they survive tmux; nvim maps <M-...>
# (tmux can't forward the cmd/super modifier: tmux/tmux#3335)
keybind = cmd+p=esc:p
keybind = cmd+b=esc:b
keybind = cmd+j=esc:j
keybind = cmd+s=esc:s
keybind = cmd+f=esc:f
keybind = cmd+/=esc:/
keybind = cmd+a=esc:a
keybind = cmd+i=esc:i

# Notify when long commands finish (if terminal is unfocused)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
