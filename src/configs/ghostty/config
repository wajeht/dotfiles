shell-integration = zsh

font-family = Monaco
font-size = 15
font-thicken = true

window-padding-y = 0
window-padding-x = 5
window-padding-balance = true
window-padding-color = extend
window-save-state = never
# window-decoration = false
window-theme = dark
macos-window-shadow = true
macos-titlebar-proxy-icon = hidden

window-height = 100
window-width = 100

theme = "dark modern"
confirm-close-surface = false
macos-titlebar-style = tabs
background=#000000
background-opacity = 0.85
# Native macOS 26+ glass. On older macOS the glass material is unavailable and
# blur silently falls back — swap the two lines below for a numeric radius there.
background-blur = macos-glass-regular
# background-blur = 35
# Apply opacity+blur to cells with explicit background colors too (frosted popups)
background-opacity-cells = true

bold-is-bright = true
cursor-opacity = .8

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false

# Creating splits
# keybind = ctrl+shift+h=new_split:left
# keybind = ctrl+shift+j=new_split:down
# keybind = ctrl+shift+k=new_split:up
# keybind = ctrl+shift+l=new_split:right

# Navigating splits
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right

# split-divider-color = #454545
unfocused-split-opacity = 1.0

keybind = cmd+plus=increase_font_size:1
keybind = cmd+kp_add=increase_font_size:1
keybind = cmd+r=reload_config

adjust-cell-height = 10%

# Add a new line when shift+enter is pressed
keybind = shift+enter=text:\n

# Open links from terminal output
# hint: action does not exist in Ghostty (checked 1.3.1) — revisit when link hints ship
# keybind = cmd+shift+o=hint:link:link-url:open_browser

# Send cmd+key as ESC key (meta) so they survive tmux; nvim maps <M-...>
# (tmux can't forward the cmd/super modifier: tmux/tmux#3335)
# cmd+j/cmd+e also override new Ghostty 1.3 defaults (scroll/search selection)
keybind = cmd+p=esc:p
keybind = cmd+b=esc:b
keybind = cmd+j=esc:j

# Tabs disabled — tmux handles multiplexing
keybind = cmd+t=unbind
keybind = cmd+alt+w=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind

# Notify when long commands finish (if terminal is unfocused)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
